[
{{- $records := slice -}}
{{- range site.RegularPages -}}
  {{- if and (not .Draft) (not (in (slice "bookmarks" "apps") .Layout)) (ne .Params.bookSearchExclude true) (ne .Params.searchRecord false) -}}
    {{- $records = $records | append (dict "id" (printf "page:%s" .RelPermalink) "type" "page" "title" (partial "docs/title" .) "section" (partial "docs/title" .Parent) "content" .Plain "href" .RelPermalink) -}}
  {{- end -}}
{{- end -}}
{{- range $section := hugo.Data.bookmarks.sections -}}
  {{- range $category := $section.categories -}}{{ range $item := $category.items }}
    {{- $linkText := "" -}}{{ range $item.links }}{{ $linkText = printf "%s %s %s" $linkText .label .url }}{{ end -}}
    {{- $text := printf "%s %s %s %s %s %s" $item.name $item.description $category.name (default "" $item.tags) (default "" $item.url) $linkText -}}
    {{- $records = $records | append (dict "id" (printf "bookmark:%s:%s" $section.id $item.id) "type" "bookmark" "title" $item.name "section" (printf "%s / %s" $section.name $category.name) "content" $text "href" $item.url) -}}
  {{- end }}{{ end }}
{{- end -}}
{{- range $group := hugo.Data.apps.groups -}}{{ range $item := $group.items }}
  {{- $text := printf "%s %s %s %s %s" $item.name $item.description $group.name (default "" $item.platforms) (default "" $item.url) -}}
  {{- $records = $records | append (dict "id" (printf "app:%s" $item.id) "type" "app" "title" $item.name "section" (printf "apps / %s" $group.name) "content" $text "href" (printf "/bookmarks/apps/#%s" $item.id)) -}}
{{- end }}{{ end }}
{{- range $i, $record := $records }}{{ if $i }},{{ end }}{{ $record | jsonify }}{{ end -}}
]
